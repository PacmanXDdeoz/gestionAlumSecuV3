[TEMPLATE]
# ============================================================
#  Plantilla de variables de entorno — Sistema de Gestión Escolar
#  Copia este archivo a `.env` y completa los valores reales.
#  `.env` está en .gitignore: NUNCA lo subas al repositorio.
# ============================================================

# Aplicación
FLASK_APP=entrypoint
APP_SETTINGS_MODULE=config.local

# Clave secreta de la aplicación (sesiones y CSRF).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_por_una_aleatoria_de_64_caracteres_hex

# ── Base de datos PRINCIPAL (producción/desarrollo) ───────────────────────
# Apunta a tu servidor remoto AlwaysData. La aplicación usa esta URI.
# Si la dejas comentada, la app usará el archivo db_uri.secret existente
# (que también contiene la URI de AlwaysData).
# DATABASE_URI=postgresql://usuario:contraseña@host-alwaysdata:5432/nombre_bd

# ── Base de datos LOCAL (respaldo / entorno secundario, opcional) ────────
# Solo se usa para backups/restore o como entorno de desarrollo aislado.
# La app principal NO la usa; se expone como DATABASE_URI_LOCAL en config.
# DATABASE_URI_LOCAL=postgresql://usuario:contraseña@localhost:5432/nombre_bd_local

# Emails con privilegios de administrador (separados por coma).
# Se suman al rol 'admin' (id 1 del catálogo de roles) para cada docente.
ADMIN_EMAILS=admin@example.com

# Email para alertas de error (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@escuela.local
MAIL_ADMINS=admin@escuela.local

# ── Códigos QR ────────────────────────────────────────────────────────────
# Dominio con el que se guardan los QRs (escaneo nativo). Si está definida,
# se usa SIEMPRE (incluso dentro de requests); si está vacía, se usa el host
# de la petición. Requerida para el comando `flask regenerate-qrs`.
# PUBLIC_BASE_URL=http://192.168.100.8:5000

# Carpeta donde se guardan los QRs de los alumnos. Opcional: por defecto usa
# <static>/qrcodes dentro del proyecto. Defínela para PERSISTIR los PNGs en
# un disco externo (p. ej. un disco persistente de Render, cuyo filesystem se
# borra en cada deploy): la app los sirve entonces por la ruta /qr/<archivo>
# en lugar de /static/... y sobreviven a los deploys.
# (El entorno de testing la redirige automáticamente a un directorio temporal
# para no ensuciar la carpeta real.)
# QR_CODES_FOLDER=/var/data/qrcodes
